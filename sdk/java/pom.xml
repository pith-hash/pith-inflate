<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.pith-hash</groupId>
  <artifactId>pith-inflate</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>pith-inflate</name>
  <description>Java JNI bindings for the pith-inflate cdylib: DEFLATE, zlib and gzip decompression with hard size limits (hex-exact vs reference.json)</description>
  <url>https://pith-inflate.n24q02m.com</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://github.com/pith-hash/pith-inflate/blob/main/LICENSE</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>pith-hash</id>
      <name>pith-hash</name>
      <url>https://github.com/pith-hash</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/pith-hash/pith-inflate</url>
    <connection>scm:git:git://github.com/pith-hash/pith-inflate.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <jackson.version>2.17.2</jackson.version>
    <surefire.version>3.2.5</surefire.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
    </plugins>
  </build>

  <!--
    Release lane: everything Maven Central requires (sources jar, javadoc
    jar, GPG signatures) plus the Central Portal publisher. Kept in a
    profile so plain `mvn test` / `mvn package` never needs GPG or
    registry credentials. Activate with `mvn -Prelease deploy`; the
    publisher reads settings.xml server id `central` (CI: setup-java's
    server-id mapping).
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <!-- The JNI bindings are deliberately terse; doclint failures
                   must not block a Central release. -->
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
